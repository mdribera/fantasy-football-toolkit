Screen {
    /* Resting-state border, same weight as my-turn/over-max below, so an
       alert only changes the border's color -- never whether the app has
       one at all, which would otherwise shift the whole layout by its
       width the instant an alert class lands. */
    border: heavy $panel;
}

Screen.my-turn {
    border: heavy $warning;
}

Screen.over-max {
    border: heavy $error;
}

#banner {
    /* Reserved even when idle -- visibility: hidden rather than display:
       none, so an alert appearing or clearing never shifts every panel
       below it. show()/hide() flip `visible`, not `display`. Fixed to one
       row (text-wrap/text-overflow) for the same reason: a long alert
       growing to two or three rows would shift the layout exactly as much
       as the old display:none toggle did. */
    visibility: hidden;
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    padding: 0 1;
    text-align: center;
    text-style: bold;
    background: $warning;
    color: $text;
}

#banner.alert {
    background: $error;
}

#body {
    height: 1fr;
}

#main {
    width: 1fr;
}

#chat {
    width: 70;
    border: round $primary;
}

#now-row {
    height: 10;
}

#status {
    width: 2fr;
    height: 1fr;
    border: round $primary;
    padding: 0 1;
}

#drafted {
    width: 2fr;
    height: 1fr;
    border: round $primary;
    padding: 0 1;
}

#middle {
    height: 1fr;
}

#bidlog {
    width: 1fr;
    border: round $primary;
}

#salelog {
    width: 1fr;
    height: 1fr;
    border: round $primary;
}

#roster {
    width: 2fr;
    border: round $primary;
}

#team-list {
    width: 34;
    border-right: solid $primary;
}

#roster-pane {
    /* Floor against #chat's fixed width competing with #middle's fr split --
       without it the roster table (fixed-width team-list already at its
       side) is what gets squeezed to nothing, not BidLog/SaleLog, which
       wrap text and tolerate narrow width far better. */
    width: 1fr;
    min-width: 20;
    padding: 0 1;
}

#roster-header {
    height: auto;
}

#roster-table {
    height: 1fr;
}

#bottom {
    height: 1fr;
}

#nominations {
    width: 3fr;
    height: 1fr;
    min-height: 5;
    border: round $primary;
}

#output {
    width: 1fr;
    border: round $primary;
}

#nominations:focus, #team-list:focus {
    border-left: thick $accent;
}

#command {
    display: none;
    dock: bottom;
}

ConfirmBidScreen {
    align: center middle;
    /* Textual's Screen type selector matches every subclass, including
       this modal -- without this it would inherit the resting border on
       top of #confirm-dialog's own, doubling up. */
    border: none;
}

#confirm-dialog {
    width: 64;
    height: auto;
    padding: 1 2;
    border: thick $warning;
    background: $panel;
    text-align: center;
}
