Screen {
    /* Resting-state border, same weight as my-turn/over-max below, so an
       alert only changes the border's color -- never whether the app has
       one at all, which would otherwise shift the whole layout by its
       width the instant an alert class lands. */
    border: heavy $panel;
}

Screen.my-turn {
    border: heavy $warning;
}

Screen.over-max {
    border: heavy $error;
}

#banner {
    display: none;
    height: auto;
    padding: 0 1;
    text-align: center;
    text-style: bold;
    background: $warning;
    color: $text;
}

#banner.alert {
    background: $error;
}

#now-row {
    height: 10;
}

#status {
    width: 2fr;
    height: 1fr;
    border: round $primary;
    padding: 0 1;
}

#drafted {
    width: 2fr;
    height: 1fr;
    border: round $primary;
    padding: 0 1;
}

#middle {
    height: 1fr;
}

#bidlog {
    width: 1fr;
    border: round $primary;
}

#salelog {
    width: 1fr;
    height: 1fr;
    border: round $primary;
}

#roster {
    width: 2fr;
    border: round $primary;
}

#team-list {
    width: 20;
    border-right: solid $primary;
}

#roster-pane {
    width: 1fr;
    padding: 0 1;
}

#roster-header {
    height: auto;
}

#roster-table {
    height: 1fr;
}

#bottom {
    height: 1fr;
}

#nominations {
    width: 3fr;
    height: 1fr;
    min-height: 5;
    border: round $primary;
}

#output {
    width: 1fr;
    border: round $primary;
}

#nominations:focus, #team-list:focus {
    border-left: thick $accent;
}

#command {
    display: none;
    dock: bottom;
}

ConfirmBidScreen {
    align: center middle;
    /* Textual's Screen type selector matches every subclass, including
       this modal -- without this it would inherit the resting border on
       top of #confirm-dialog's own, doubling up. */
    border: none;
}

#confirm-dialog {
    width: 64;
    height: auto;
    padding: 1 2;
    border: thick $warning;
    background: $panel;
    text-align: center;
}
