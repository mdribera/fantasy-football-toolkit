# ESPN Fantasy credentials
# League ID: the leagueId=XXXXXXX number in your ESPN league URL
ESPN_LEAGUE_ID=

# Season year
ESPN_SEASON=2026

# Private-league auth cookies.
# Get them: log into fantasy.espn.com in Chrome -> F12 -> Application tab ->
# Storage -> Cookies -> https://fantasy.espn.com -> copy the values of
# `SWID` (include the curly braces) and `espn_s2` (long URL-encoded string).
ESPN_SWID=
ESPN_S2=

# Your team ID within the league (find with: python scripts/whoami.py)
ESPN_TEAM_ID=
